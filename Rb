            importBtn.BackgroundColor3 = COLOR_DANGER
            log("Gagal load: " .. fileName)
        end
    end)

    return card
end

-- ============ SCAN ============
local scanning = false

local function scanFiles()
    if scanning then return end
    scanning = true

    for _, child in ipairs(fileScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    foundFiles = {}

    -- Loading state
    scanBtn.Text = "SCANNING..."
    scanBtn.BackgroundColor3 = COLOR_SURFACE_2
    statusDot.BackgroundColor3 = Color3.fromRGB(240, 200, 80)
    statusLabel.Text = "SCANNING..."
    log("Scanning file...")

    task.wait(0.1)

    local files = {}
    local pathsToTry = {
        "/sdcard/Download",
        "/sdcard/Documents",
        "/sdcard",
        "workspace", "", ".", "./"
    }
    for _, p in ipairs(pathsToTry) do
        local ok, res = pcall(function() return getFiles(p) end)
        if ok and type(res) == "table" and #res > 0 then
            for _, f in ipairs(res) do table.insert(files, f) end
        end
    end

    local rbxmCount, rbxlCount = 0, 0
    for _, filePath in ipairs(files) do
        local fileName = filePath:match("[^/\\]+$") or filePath
        local ext = fileName:match("%.([^%.]+)$")
        if ext then
            local e = ext:lower()
            if e == "rbxm" or e == "rbxmx" or e == "rbxl" or e == "rbxlx" then
                local card = makeFileCard(fileName, e, filePath)
                table.insert(foundFiles, {row = card, name = fileName, ext = e})
                if e == "rbxm" or e == "rbxmx" then rbxmCount = rbxmCount + 1
                else rbxlCount = rbxlCount + 1 end
            end
        end
    end

    scanBtn.Text = "SCAN"
    scanBtn.BackgroundColor3 = COLOR_ACCENT
    statusDot.BackgroundColor3 = COLOR_SUCCESS
    statusLabel.Text = string.format("SCAN COMPLETE  •  RBXL %d  •  RBXM %d", rbxlCount, rbxmCount)
    countsLabel.Text = string.format("FILES %d  •  IMP 0", #foundFiles)
    log(string.format("Scan selesai. %d file ditemukan.", #foundFiles))

    scanning = false
end

