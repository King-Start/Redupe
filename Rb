local function makeMenuItem(text, posY, icon)
    local row = Instance.new("Frame")
    row.BackgroundColor3 = COLOR_BG
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, -20, 0, 30)
    row.Position = UDim2.new(0, 10, 0, posY)
