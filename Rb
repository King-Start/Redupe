local function applyGradient(target, cA, cB, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, cA),
        ColorSequenceKeypoint.new(1, cB),
    })
    g.Rotation = rot or 0
    g.Parent = target
    return g
end

local function applyTextGradient(label, cA, cMid, cB)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, cA),
        ColorSequenceKeypoint.new(0.5, cMid or cA),
        ColorSequenceKeypoint.new(1, cB),
    })
    g.Parent = label
    return g
end

local function applyVortexBorder(stroke, thickness, speed)
    stroke.Thickness = thickness or 2.5
    stroke.Transparency = 0
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 40, 60)),
        ColorSequenceKeypoint.new(0.20, Color3.fromRGB(255, 130, 150)),
        ColorSequenceKeypoint.new(0.40, Color3.fromRGB(80, 10, 25)),
        ColorSequenceKeypoint.new(0.60, Color3.fromRGB(255, 60, 90)),
        ColorSequenceKeypoint.new(0.80, Color3.fromRGB(140, 15, 30)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 40, 60)),
    })
    grad.Parent = stroke
    RunService.RenderStepped:Connect(function()
        grad.Rotation = (tick() * (speed or 60)) % 360
    end)
    return grad
end

local function processModelParts(inst)
    if not inst then return end
    if inst.ClassName == "DataModel" then
        print("[SADVZE] DataModel detected")
        for _, svc in ipairs(inst:GetChildren()) do
            local targetSvc = game:FindFirstChild(svc.ClassName)
            if targetSvc and targetSvc ~= game then
                print("[SADVZE] Restore:", svc.ClassName)
                for _, child in ipairs(svc:GetChildren()) do
                    pcall(function() child.Parent = targetSvc end)
                end
            end
        end
        return
    end
    if inst:IsA("BasePart") then
        inst.Anchored = true
        inst.CanCollide = true
    end
    for _, desc in ipairs(inst:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.Anchored = true
            desc.CanCollide = true
        end
    end
end

local function refreshScripts(model)
    task.defer(function()
        for _, desc in ipairs(model:GetDescendants()) do
            if desc:IsA("LocalScript") then
                local cur = desc.Enabled
                desc.Enabled = false
                task.wait(0.2)
                desc.Enabled = cur
            end
        end
    end)
end

-- ============================================================
-- CONVERTER: .rbxl → .rbxm (multiple path fallback)
-- ============================================================
local function convertRbxlToRbxm(filePath)
    local raw = nil
    local okRead = pcall(function() raw = readFileData(filePath) end)
    if not okRead or not raw then
        print("[CONV] Gagal baca file")
        return nil
    end

    print("[CONV] Size:", #raw, "bytes (", math.floor(#raw/1024), "KB )")

    local magic = string.sub(raw, 1, 8)
    local isBinary = (magic == "<roblox!")
    local isXml = (string.find(string.sub(raw,1,100), "<roblox", 1, true) ~= nil)
    print("[CONV] Format:", isBinary and "BINARY" or (isXml and "XML" or "UNKNOWN"))

    if not writeFileData then
        print("[CONV] writefile nggak ada")
        return nil
    end

    local paths = {
        "sadvze_temp.rbxm",
        "_sadvze_temp.rbxm",
    }

    for _, p in ipairs(paths) do
        local okW, err = pcall(function() writeFileData(p, raw) end)
        if okW then
            print("[CONV] Written:", p)
            return p
        else
            print("[CONV] Failed:", p, "→", tostring(err))
        end
    end

    print("[CONV] Semua path gagal")
    return nil
end

-- ============================================================
-- LOAD: direct .rbxl dulu, baru convert, baru getobjects
-- ============================================================
local function loadModelFile(filePath)
    local toInsert = {}
    local isRbxl = string.find(string.lower(filePath), "%.rbxl") ~= nil

    print("[LOAD] Direct attempt:", filePath)
    local okAsset, aid = pcall(function() return getAsset(filePath) end)
    print("[LOAD] getAsset:", aid)

    -- Priority 1: direct InsertService pada .rbxl asli
    if aid and aid ~= "" then
        local okIns, resIns = pcall(function()
            return InsertService:LoadLocalAsset(aid)
        end)
        if okIns and resIns then
            print("[LOAD] InsertService (direct):", resIns.ClassName, resIns.Name, "children:", #resIns:GetChildren())
            if resIns.ClassName ~= "TimerService" then
                table.insert(toInsert, resIns)
                return toInsert
            end
        end
    end

    -- Priority 2: convert kalau .rbxl
    if isRbxl then
        local converted = convertRbxlToRbxm(filePath)
        if converted then
            local okA2, aid2 = pcall(function() return getAsset(converted) end)
            if okA2 and aid2 and aid2 ~= "" then
                local okI2, res2 = pcall(function()
                    return InsertService:LoadLocalAsset(aid2)
                end)
                if okI2 and res2 then
                    print("[LOAD] Via convert:", res2.ClassName, res2.Name, "children:", #res2:GetChildren())
                    if res2.ClassName ~= "TimerService" then
                        table.insert(toInsert, res2)
                        return toInsert
                    end
                end
            end
        end
    end

    -- Priority 3: getobjects
    local okGet, res = pcall(function()
        if getobjects then
            return getobjects(aid ~= "" and aid or filePath)
        end
    end)
    if okGet and res and type(res) == "table" and #res > 0 then
        for _, obj in ipairs(res) do
            print("[LOAD] getobjects:", obj.ClassName, obj.Name, "children:", #obj:GetChildren())
            table.insert(toInsert, obj)
        end
    end

    return toInsert
end

