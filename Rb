-- ============ EXECUTOR DETECT ============
local function getExecutor()
    if syn then return "Synapse" end
    if fluxus then return "Fluxus" end
    if delta then return "Delta" end
    if codex then return "Codex" end
    if arceusx then return "ArceusX" end
    if KRNL_LOADED then return "Krnl" end
    return "Unknown"
end

local function listFiles(path)
    if listfiles then return listfiles(path) end
    if syn and syn.listfiles then return syn.listfiles(path) end
    if fluxus and fluxus.listfiles then return fluxus.listfiles(path) end
    return nil
end

local function readFile(path)
    if readfile then return readfile(path) end
    if syn and syn.readfile then return syn.readfile(path) end
    if fluxus and fluxus.readfile then return fluxus.readfile(path) end
    return nil
end

local function isModelFile(name)
    local lower = string.lower(name)
    for _, ext in ipairs(CONFIG.Extensions) do
        if string.sub(lower, -#ext) == ext then return true, ext end
    end
    return false, nil
end

