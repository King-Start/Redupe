local function corner(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = inst
    return c
end

local function makeLabel(parent, text, size, pos, color, font, textSize, xAlign)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.Font = font or Enum.Font.GothamMedium
    l.TextSize = textSize or 10
    l.TextColor3 = color or COLOR_TEXT
    l.TextXAlignment = xAlign or Enum.TextXAlignment.Left
    l.Size = size
    l.Position = pos
    l.Parent = parent
    return l
end

local function applyGradient(target, cA, cB, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, cA),
        ColorSequenceKeypoint.new(1, cB),
    })
    g.Rotation = rot or 0
    g.Parent = target
    return g
end

local function applyTextGradient(label, cA, cMid, cB)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, cA),
        ColorSequenceKeypoint.new(0.5, cMid or cA),
        ColorSequenceKeypoint.new(1, cB),
    })
    g.Parent = label
    return g
end

local function applyVortexBorder(stroke, thickness, speed)
    stroke.Thickness = thickness or 3
    stroke.Transparency = 0
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 60, 90)),
        ColorSequenceKeypoint.new(0.15, Color3.fromRGB(255, 180, 200)),
        ColorSequenceKeypoint.new(0.35, Color3.fromRGB(200, 20, 50)),
        ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 100, 130)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(140, 15, 30)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 60, 90)),
    })
    grad.Parent = stroke
    RunService.RenderStepped:Connect(function()
        grad.Rotation = (tick() * (speed or 60)) % 360
    end)
    return grad
end

local function processModelParts(inst)
    if not inst then return end
    if inst.ClassName == "DataModel" then
        print("[SADVZE] DataModel detected")
        for _, svc in ipairs(inst:GetChildren()) do
            local targetSvc = game:FindFirstChild(svc.ClassName)
            if targetSvc and targetSvc ~= game then
                for _, child in ipairs(svc:GetChildren()) do
                    pcall(function() child.Parent = targetSvc end)
                end
            end
        end
        return
    end
    if inst:IsA("BasePart") then
        inst.Anchored = true
        inst.CanCollide = true
    end
    for _, desc in ipairs(inst:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.Anchored = true
            desc.CanCollide = true
        end
    end
end

local function refreshScripts(model)
    task.defer(function()
        for _, desc in ipairs(model:GetDescendants()) do
            if desc:IsA("LocalScript") then
                local cur = desc.Enabled
                desc.Enabled = false
                task.wait(0.2)
                desc.Enabled = cur
            end
        end
    end)
end

local function loadModelFile(filePath)
    local toInsert = {}
    local okAsset, aid = pcall(function() return getAsset(filePath) end)

    if aid and aid ~= "" then
        local okIns, resIns = pcall(function()
            return InsertService:LoadLocalAsset(aid)
        end)
        if okIns and resIns and resIns.ClassName ~= "TimerService" then
            table.insert(toInsert, resIns)
            return toInsert
        end
    end

    local okGet, res = pcall(function()
        if getobjects then
            return getobjects(aid ~= "" and aid or filePath)
        end
    end)
    if okGet and res and type(res) == "table" and #res > 0 then
        for _, obj in ipairs(res) do
            table.insert(toInsert, obj)
        end
    end
    return toInsert
end

