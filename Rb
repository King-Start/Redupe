local RESTRICTED_SERVICES = {
    TimerService = true, CoreGui = true, CorePackages = true,
    Chat = true, ScriptContext = true, LogService = true,
    ContentProvider = true, HttpService = true, MarketplaceService = true,
    MemoryStoreService = true, PolicyService = true, DataStoreService = true,
    UserInputService = true, ContextActionService = true, GuiService = true,
