    cardStroke.Parent = card

    -- Extension badge
    local badge = Instance.new("TextButton")
    badge.Text = string.upper(fileExt)
    badge.Font = Enum.Font.GothamBold
    badge.TextSize = 8
    badge.TextColor3 = COLOR_TEXT
    badge.BackgroundColor3 = extColor
    badge.Size = UDim2.new(0, 46, 0, 18)
    badge.Position = UDim2.new(0, 10, 0, 8)
    badge.ZIndex = 3
    badge.AutoButtonColor = false
    badge.Parent = card
    corner(badge, 4)

    -- Import button
    local importBtn = Instance.new("TextButton")
    importBtn.Text = "IMPORT"
    importBtn.Font = Enum.Font.GothamBold
    importBtn.TextSize = 8
    importBtn.TextColor3 = COLOR_TEXT
    importBtn.BackgroundColor3 = extColor
    importBtn.Size = UDim2.new(0, 62, 0, 22)
    importBtn.Position = UDim2.new(1, -72, 0, 8)
    importBtn.ZIndex = 3
    importBtn.Parent = card
    corner(importBtn, 5)
    importBtn.MouseEnter:Connect(function()
        TweenService:Create(importBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = COLOR_ACCENT_H,
        }):Play()
    end)
    importBtn.MouseLeave:Connect(function()
        TweenService:Create(importBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = extColor,
        }):Play()
    end)

    -- Name
    local nameLbl = makeLabel(card, fileName, UDim2.new(1, -90, 0, 16),
        UDim2.new(0, 10, 0, 30), COLOR_TEXT, Enum.Font.GothamBold, 10)
    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
    nameLbl.ZIndex = 3

    -- Path
    local pathLbl = makeLabel(card, filePath, UDim2.new(1, -20, 0, 12),
        UDim2.new(0, 10, 0, 46), COLOR_MUTED, Enum.Font.Code, 8)
    pathLbl.TextTruncate = Enum.TextTruncate.AtEnd
    pathLbl.ZIndex = 3

    importBtn.MouseButton1Click:Connect(function()
        importBtn.Text = "..."
        addLog("Loading: " .. fileName)

        local loaded = loadModelFile(filePath)
        if loaded and #loaded > 0 then
            for _, obj in ipairs(loaded) do
                processModelParts(obj)

                -- .rbxl/rbxlx sering balik sebagai DataModel-ish, parent ke Workspace aman
                if obj:IsA("DataModel") then
                    for _, child in ipairs(obj:GetChildren()) do
                        if child.Name == "Workspace" then
                            for _, wsChild in ipairs(child:GetChildren()) do
                                wsChild.Parent = Workspace
                            end
                        end
                    end
                else
                    obj.Parent = Workspace
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = LocalPlayer.Character.HumanoidRootPart
                        local spawnCFrame = hrp.CFrame + (hrp.CFrame.LookVector * 6)
                        if obj:IsA("Model") and obj.PrimaryPart then
                            obj:SetPrimaryPartCFrame(spawnCFrame)
                        elseif obj:IsA("BasePart") then
                            obj.CFrame = spawnCFrame
                        end
                    end
                end

                processModelParts(obj)
                refreshScripts(obj)
                addLog("OK: " .. tostring(obj.Name))
            end
            importBtn.Text = "✓ DONE"
            importBtn.BackgroundColor3 = COLOR_SUCCESS
        else
            importBtn.Text = "✗ FAIL"
            importBtn.BackgroundColor3 = COLOR_DANGER
            addLog("Gagal load: " .. fileName)
        end
    end)

    return card
end

local function scanWorkspaceFolder()
    for _, child in ipairs(fileScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    foundFiles = {}
    addLog("Scanning...")

    local files = {}
    local pathsToTry = {
        "/sdcard/Download",
        "/sdcard/Documents",
        "/sdcard",
        "workspace", "", ".", "./"
    }

    for _, p in ipairs(pathsToTry) do
        local ok, res = pcall(function() return getFiles(p) end)
        if ok and type(res) == "table" and #res > 0 then
            for _, f in ipairs(res) do table.insert(files, f) end
        end
    end

    if #files == 0 then
        addLog("Nggak ada file ditemukan.")
        return
    end

    for _, filePath in ipairs(files) do
        local fileName = filePath:match("[^/\\]+$") or filePath
        local ext = fileName:match("%.([^%.]+)$")
        if ext then
            local e = ext:lower()
            if e == "rbxm" or e == "rbxmx" or e == "rbxl" or e == "rbxlx" then
                local card = makeFileCard(fileName, e, filePath)
                table.insert(foundFiles, {row = card, name = fileName, ext = e})
            end
        end
    end

    addLog("Scan selesai. Ditemukan: " .. #foundFiles)
end

local function updateFilter(selected)
    currentFilter = selected
    btnAll.BackgroundColor3   = (selected == "ALL")   and COLOR_ACCENT or COLOR_SURFACE
    btnRbxm.BackgroundColor3  = (selected == "rbxm")  and COLOR_RBXM   or COLOR_SURFACE
    btnRbxmx.BackgroundColor3 = (selected == "rbxmx") and COLOR_RBXM   or COLOR_SURFACE
    btnRbxl.BackgroundColor3  = (selected == "rbxl")  and COLOR_RBXL   or COLOR_SURFACE

    local query = searchBox.Text:lower()
    for _, item in ipairs(foundFiles) do
        local matchSearch = (query == "" or item.name:lower():find(query, 1, true) ~= nil)
        local matchType = (currentFilter == "ALL")
            or (currentFilter == "rbxl" and (item.ext == "rbxl" or item.ext == "rbxlx"))
            or (item.ext == currentFilter)
        item.row.Visible = matchSearch and matchType
    end
end

