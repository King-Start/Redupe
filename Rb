local function switchPage(name, menu)
    pageOverview.Visible = (name == "ov")
    pageParser.Visible = (name == "pa")
    pageImporter.Visible = (name == "im")
    if name == "ov" then panelTitle.Text = "System Profile"
    elseif name == "pa" then panelTitle.Text = "Parser"
    else panelTitle.Text = "Importer" end
    if menu then menu.setActive(true) end
end

