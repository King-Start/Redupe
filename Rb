-- ============ SCAN & RENDER ============
local foundFiles = {}

local function scanWorkspaceFolder()
    for _, child in ipairs(fileScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    foundFiles = {}
    addLog("Scanning...")

    local files = {}
    local pathsToTry = {
        "/sdcard/Download",
        "/sdcard/Documents",
        "/sdcard",
        "workspace", "", ".", "./"
    }

    for _, p in ipairs(pathsToTry) do
        local ok, res = pcall(function() return getFiles(p) end)
        if ok and type(res) == "table" and #res > 0 then
            for _, f in ipairs(res) do table.insert(files, f) end
        end
    end

    if #files == 0 then
        addLog("Nggak ada file ditemukan.")
        return
    end

    for _, filePath in ipairs(files) do
        local fileName = filePath:match("[^/\\]+$") or filePath
        local ext = fileName:match("%.([^%.]+)$")
        if ext and (ext:lower() == "rbxm" or ext:lower() == "rbxmx") then
            local fileExt = ext:lower()

            local card = Instance.new("Frame")
            card.BackgroundColor3 = COLOR_SURFACE
            card.Size = UDim2.new(1, -4, 0, 36)
            card.Parent = fileScroll
            corner(card, 6)

            makeLabel(card, fileName, UDim2.new(0.65, 0, 0, 14), UDim2.new(0, 10, 0, 6), COLOR_TEXT, Enum.Font.GothamBold, 8)
            makeLabel(card, string.upper(fileExt), UDim2.new(0.65, 0, 0, 10), UDim2.new(0, 10, 0, 20), COLOR_MUTED, Enum.Font.Gotham, 7)

            local insertBtn = Instance.new("TextButton")
            insertBtn.Text = "IMPORT"
            insertBtn.Font = Enum.Font.GothamBold
            insertBtn.TextSize = 7
            insertBtn.TextColor3 = COLOR_TEXT
            insertBtn.BackgroundColor3 = COLOR_PURPLE
            insertBtn.Size = UDim2.new(0, 58, 0, 20)
            insertBtn.Position = UDim2.new(1, -64, 0.5, -10)
            insertBtn.Parent = card
            corner(insertBtn, 4)

            insertBtn.MouseEnter:Connect(function() insertBtn.BackgroundColor3 = COLOR_PURPLE_H end)
            insertBtn.MouseLeave:Connect(function() insertBtn.BackgroundColor3 = COLOR_PURPLE end)

            insertBtn.MouseButton1Click:Connect(function()
                addLog("Loading: " .. fileName)
                local loaded = loadModelFile(filePath)
                if loaded and #loaded > 0 then
                    for _, obj in ipairs(loaded) do
                        processModelParts(obj)
                        obj.Parent = Workspace
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            local hrp = LocalPlayer.Character.HumanoidRootPart
                            local spawnCFrame = hrp.CFrame + (hrp.CFrame.LookVector * 6)
                            if obj:IsA("Model") and obj.PrimaryPart then
                                obj:SetPrimaryPartCFrame(spawnCFrame)
                            elseif obj:IsA("BasePart") then
                                obj.CFrame = spawnCFrame
                            end
                        end
                        processModelParts(obj)
                        refreshScripts(obj)
                        addLog("OK: " .. obj.Name)
                    end
                else
                    addLog("Gagal load: " .. fileName)
                end
            end)

            table.insert(foundFiles, {row = card, name = fileName, ext = fileExt})
        end
    end

    addLog("Scan selesai. Ditemukan: " .. #foundFiles)
end

local function updateFilter(selected)
    currentFilter = selected
    btnAll.BackgroundColor3   = (selected == "ALL")   and COLOR_PURPLE or COLOR_SURFACE
    btnRbxm.BackgroundColor3  = (selected == "rbxm")  and COLOR_PURPLE or COLOR_SURFACE
    btnRbxmx.BackgroundColor3 = (selected == "rbxmx") and COLOR_PURPLE or COLOR_SURFACE

    local query = searchBox.Text:lower()
    for _, item in ipairs(foundFiles) do
        local matchSearch = (query == "" or item.name:lower():find(query, 1, true) ~= nil)
        local matchType   = (currentFilter == "ALL" or item.ext == currentFilter:lower())
        item.row.Visible = matchSearch and matchType
    end
end

