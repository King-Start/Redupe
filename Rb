-- ============ FILE CARD ============
local function buildCard(file)
    local card = make("Frame", {
        Size = UDim2.new(1, 0, 0, 78),
        BackgroundColor3 = Color3.fromRGB(20, 20, 30),
        BorderSizePixel = 0,
    }, {corner(10), stroke(Color3.fromRGB(60, 60, 90), 1)})

    local extColor = file.ext == ".rbxm" and Color3.fromRGB(120, 90, 220)
        or file.ext == ".rbxl" and Color3.fromRGB(80, 140, 220)
        or Color3.fromRGB(200, 120, 60)

    make("TextButton", {
        Size = UDim2.new(0, 50, 0, 20),
        Position = UDim2.new(0, 10, 0, 8),
        BackgroundColor3 = extColor,
        Text = string.upper(string.gsub(file.ext, "%.", "")),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        BorderSizePixel = 0,
        AutoButtonColor = false,
    }, {corner(5)}).Parent = card

    local importBtn = make("TextButton", {
        Size = UDim2.new(0, 70, 0, 22),
        Position = UDim2.new(1, -80, 0, 8),
        BackgroundColor3 = extColor,
        Text = "IMPORT",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        BorderSizePixel = 0,
    }, {corner(5)})
    importBtn.Parent = card

    make("TextLabel", {
        Size = UDim2.new(1, -100, 0, 18),
        Position = UDim2.new(0, 10, 0, 30),
        BackgroundTransparency = 1,
        Text = file.name,
        TextColor3 = CONFIG.TextColor,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }).Parent = card

    make("TextLabel", {
        Size = UDim2.new(1, -20, 0, 14),
        Position = UDim2.new(0, 10, 0, 50),
        BackgroundTransparency = 1,
        Text = file.path,
        TextColor3 = Color3.fromRGB(110, 110, 140),
        Font = Enum.Font.Code,
        TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }).Parent = card

    importBtn.MouseButton1Click:Connect(function()
        importBtn.Text = "..."
        log("Importing: " .. file.name)

        local ok, err = pcall(function()
            -- Cek GetObjects
            if type(game.GetObjects) == "function" then
                local got = game:GetObjects(file.path)
                if got and #got > 0 then
                    for _, obj in ipairs(got) do
                        obj.Parent = game:GetService("Workspace")
                    end
                    return true, "GetObjects (" .. #got .. " objek)"
                end
            end

            -- Fallback InsertService
            local IS = game:GetService("InsertService")
            if type(IS.LoadLocalAsset) == "function" then
                local model = IS:LoadLocalAsset(file.path)
                if model then
                    model.Parent = game:GetService("Workspace")
                    return true, "InsertService"
                end
            end

            error("Semua method import gagal")
        end)

        if ok then
            State.imported = State.imported + 1
            importBtn.Text = "DONE"
            importBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
            countsLabel.Text = string.format("FILES %d  •  IMP %d", #State.files, State.imported)
            log("Berhasil: " .. file.name .. " via " .. tostring(err))
        else
            importBtn.Text = "FAIL"
            importBtn.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
            log("Gagal: " .. tostring(err))
        end
    end)

    return card
end

-- ============ RENDER ============
local function renderFiles(filter)
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local shown = 0
    for _, file in ipairs(State.files) do
        if filter == "" or string.find(string.lower(file.name), string.lower(filter), 1, true) then
            buildCard(file).Parent = scroll
            shown = shown + 1
        end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, shown * 84)
end

-- ============ SCAN ============
scanBtn.MouseButton1Click:Connect(function()
    if not _listfiles then
        log("listfiles() nggak ada. Pakai IMPORT PATH manual.")
        statusLabel.Text = "NO LISTFILES"
        statusDot.BackgroundColor3 = Color3.fromRGB(240, 200, 80)
        return
    end

    scanBtn.Text = "SCANNING..."
    statusLabel.Text = "SCANNING..."
    statusDot.BackgroundColor3 = Color3.fromRGB(240, 200, 80)
    State.files = {}
    State.rbxm = 0
    State.rbxl = 0

    wait_(0.1)

    for _, dir in ipairs(CONFIG.ScanPaths) do
        local ok, files = pcall(_listfiles, dir)
        if ok and type(files) == "table" then
            for _, path in ipairs(files) do
                local name = string.match(path, "([^/]+)$") or path
                local lower = string.lower(name)
                local ext = nil
                if string.sub(lower, -5) == ".rbxm" then ext = ".rbxm"
                elseif string.sub(lower, -5) == ".rbxl" then ext = ".rbxl"
                elseif string.sub(lower, -6) == ".rbxlx" then ext = ".rbxlx" end

                if ext then
                    table.insert(State.files, {name = name, path = path, ext = ext})
                    if ext == ".rbxm" then State.rbxm = State.rbxm + 1
                    else State.rbxl = State.rbxl + 1 end
                end
            end
        end
    end

    wait_(0.1)
    renderFiles("")
    scanBtn.Text = "SCAN"
    statusDot.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
    statusLabel.Text = string.format("SCAN OK  •  RBXL %d  •  RBXM %d", State.rbxl, State.rbxm)
    countsLabel.Text = string.format("FILES %d  •  IMP %d", #State.files, State.imported)
    log(string.format("Scan selesai: %d file.", #State.files))
end)

-- ============ MANUAL IMPORT ============
manualBtn.MouseButton1Click:Connect(function()
    local path = manualBox.Text
    if path == "" then
        log("Path kosong. Ketik dulu.")
        return
    end
    local name = string.match(path, "([^/]+)$") or path
    local ext = string.sub(string.lower(name), -5)
    if ext ~= ".rbxm" and ext ~= ".rbxl" and string.sub(string.lower(name), -6) ~= ".rbxlx" then
        log("Extensi bukan .rbxm/.rbxl/.rbxlx")
        return
    end
    table.insert(State.files, {name = name, path = path, ext = "." .. string.gsub(ext, "%.", "")})
    renderFiles("")
    log("Ditambah manual: " .. name)
end)

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    renderFiles(searchBox.Text)
end)

