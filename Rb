local function makeFileCard(fileName, fileExt, filePath, parentFrame)
    local isRbxm = (fileExt == "rbxm" or fileExt == "rbxmx")
    local extColor = isRbxm and COLOR_RBXM or COLOR_RBXL

    local card = Instance.new("Frame")
    card.BackgroundColor3 = COLOR_SURFACE_2
    card.Size = UDim2.new(1, -4, 0, 62)
    card.ZIndex = 54
    card.Parent = parentFrame
    corner(card, 10)
    applyGradient(card, Color3.fromRGB(30, 12, 20), Color3.fromRGB(16, 12, 18), 0)

    local badge = Instance.new("TextButton")
    badge.Text = string.upper(fileExt)
    badge.Font = Enum.Font.GothamBold
    badge.TextSize = 8
    badge.TextColor3 = COLOR_TEXT
    badge.BackgroundColor3 = extColor
    badge.Size = UDim2.new(0, 46, 0, 18)
    badge.Position = UDim2.new(0, 10, 0, 8)
    badge.ZIndex = 55
    badge.AutoButtonColor = false
    badge.Parent = card
    corner(badge, 5)
    applyGradient(badge,
        isRbxm and Color3.fromRGB(210, 80, 110) or Color3.fromRGB(240, 60, 90),
        isRbxm and Color3.fromRGB(120, 25, 50) or Color3.fromRGB(140, 15, 35), 0)

    local importBtn = Instance.new("TextButton")
    importBtn.Text = "IMPORT"
    importBtn.Font = Enum.Font.GothamBold
    importBtn.TextSize = 8
    importBtn.TextColor3 = COLOR_TEXT
    importBtn.BackgroundColor3 = extColor
    importBtn.Size = UDim2.new(0, 62, 0, 22)
    importBtn.Position = UDim2.new(1, -72, 0, 8)
    importBtn.ZIndex = 55
    importBtn.Parent = card
    corner(importBtn, 5)
    applyGradient(importBtn,
        isRbxm and Color3.fromRGB(210, 80, 110) or Color3.fromRGB(240, 60, 90),
        isRbxm and Color3.fromRGB(120, 25, 50) or Color3.fromRGB(140, 15, 35), 0)

    makeLabel(card, fileName, UDim2.new(1,-100,0,14),
        UDim2.new(0, 10, 0, 30), COLOR_TEXT, Enum.Font.GothamBold, 9).ZIndex = 55
    makeLabel(card, filePath, UDim2.new(1,-20,0,12),
        UDim2.new(0, 10, 0, 46), COLOR_MUTED, Enum.Font.Code, 7).ZIndex = 55

    importBtn.MouseButton1Click:Connect(function()
        importBtn.Text = "..."
        local loaded = loadModelFile(filePath)
        if loaded and #loaded > 0 then
            local inserted = false
            for _, obj in ipairs(loaded) do
                if not (obj.ClassName == "TimerService" and #obj:GetChildren() == 0) then
                    pcall(function() obj.Parent = Workspace end)
                    processModelParts(obj)
                    refreshScripts(obj)
                    inserted = true
                end
            end
            if inserted then
                importBtn.Text = "✓ DONE"
                importBtn.BackgroundColor3 = COLOR_SUCCESS
            else
                importBtn.Text = "✗ EMPTY"
                importBtn.BackgroundColor3 = COLOR_DANGER
            end
        else
            importBtn.Text = "✗ FAIL"
            importBtn.BackgroundColor3 = COLOR_DANGER
        end
    end)
end

local scanning = false
local function scanFiles()
    if scanning then return end
    scanning = true

    for _, c in ipairs(parserScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for _, c in ipairs(importerScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    local files = {}
    for _, p in ipairs({"/sdcard/Download", "/sdcard/Documents", "/sdcard", "workspace", "", ".", "./"}) do
        local ok, res = pcall(function() return getFiles(p) end)
        if ok and type(res) == "table" and #res > 0 then
            for _, f in ipairs(res) do table.insert(files, f) end
        end
    end

    for _, filePath in ipairs(files) do
        local fileName = filePath:match("[^/\\]+$") or filePath
        local ext = fileName:match("%.([^%.]+)$")
        if ext then
            local e = ext:lower()
            if e == "rbxm" or e == "rbxmx" then
                makeFileCard(fileName, e, filePath, parserScroll)
            elseif e == "rbxl" or e == "rbxlx" then
                makeFileCard(fileName, e, filePath, importerScroll)
            end
        end
    end

    scanning = false
end

rescanBtn.MouseButton1Click:Connect(scanFiles)

