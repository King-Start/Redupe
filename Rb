local function makeMenuItem(text, posY, icon, iconColor)
    local row = Instance.new("TextButton")
    row.BackgroundTransparency = 1
    row.Text = ""
    row.AutoButtonColor = false
    row.Size = UDim2.new(1, -20, 0, 32)
    row.Position = UDim2.new(0, 10, 0, posY)
    row.ZIndex = 52
    row.Parent = sidebar
    corner(row, 8)

    -- Accent bar di kiri (muncul kalau aktif)
    local accentBar = Instance.new("Frame")
    accentBar.BackgroundColor3 = COLOR_ACCENT_H
    accentBar.Size = UDim2.new(0, 3, 0, 18)
    accentBar.Position = UDim2.new(0, 0, 0.5, -9)
    accentBar.ZIndex = 54
    accentBar.BackgroundTransparency = 1
    accentBar.Parent = row
    corner(accentBar, 2)

    local ico = makeLabel(row, icon, UDim2.new(0, 24, 1, 0),
        UDim2.new(0, 10, 0, 0), iconColor or COLOR_ACCENT_H, Enum.Font.GothamBold, 14)
    ico.ZIndex = 53

    local lbl = makeLabel(row, text, UDim2.new(1, -40, 1, 0),
        UDim2.new(0, 34, 0, 0), COLOR_MUTED, Enum.Font.GothamMedium, 10)
    lbl.ZIndex = 53

    local function setActive(on)
        if on then
            row.BackgroundTransparency = 0
            row.BackgroundColor3 = COLOR_ACCENT
            if not row:FindFirstChildOfClass("UIGradient") then
                applyGradient(row, Color3.fromRGB(240, 60, 90), Color3.fromRGB(120, 20, 35), 0)
            end
            accentBar.BackgroundTransparency = 0
            ico.TextColor3 = COLOR_TEXT
            lbl.TextColor3 = COLOR_TEXT
            lbl.Font = Enum.Font.GothamBold
        else
            row.BackgroundTransparency = 1
            local g = row:FindFirstChildOfClass("UIGradient")
            if g then g:Destroy() end
            accentBar.BackgroundTransparency = 1
            ico.TextColor3 = iconColor or COLOR_ACCENT_H
            lbl.TextColor3 = COLOR_MUTED
            lbl.Font = Enum.Font.GothamMedium
        end
    end

    -- Hover effect
    row.MouseEnter:Connect(function()
        if row.BackgroundTransparency == 1 then
            TweenService:Create(row, TweenInfo.new(0.15), {BackgroundTransparency = 0.7}):Play()
            row.BackgroundColor3 = COLOR_SURFACE_2
        end
    end)
    row.MouseLeave:Connect(function()
        if row.BackgroundTransparency ~= 1 and row.BackgroundColor3 == COLOR_SURFACE_2 then
            TweenService:Create(row, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
        end
    end)

    return {row = row, lbl = lbl, ico = ico, setActive = setActive}
end

