btnRbxmx.MouseButton1Click:Connect(function() updateFilter("rbxmx") end)
searchBox:GetPropertyChangedSignal("Text"):Connect(function() updateFilter(currentFilter) end)
refreshBtn.MouseButton1Click:Connect(scanWorkspaceFolder)

