local function makeMenuItem(text, posY, icon)
    local row = Instance.new("TextButton")
    row.BackgroundTransparency = 1
    row.Text = ""
    row.AutoButtonColor = false
    row.Size = UDim2.new(1, -16, 0, 28)
    row.Position = UDim2.new(0, 8, 0, posY)
    row.ZIndex = 52
    row.Parent = sidebar
    corner(row, 7)

    local ico = makeLabel(row, icon, UDim2.new(0, 20, 1, 0),
        UDim2.new(0, 8, 0, 0), COLOR_MUTED, Enum.Font.GothamBold, 11)
    ico.ZIndex = 53

    local lbl = makeLabel(row, text, UDim2.new(1, -30, 1, 0),
        UDim2.new(0, 28, 0, 0), COLOR_MUTED, Enum.Font.GothamMedium, 10)
    lbl.ZIndex = 53

    local function setActive(on)
        if on then
            row.BackgroundTransparency = 0
            row.BackgroundColor3 = COLOR_ACCENT
            if not row:FindFirstChildOfClass("UIGradient") then
                applyGradient(row, Color3.fromRGB(240, 60, 90), Color3.fromRGB(160, 20, 40), 0)
            end
            ico.TextColor3 = COLOR_TEXT
            lbl.TextColor3 = COLOR_TEXT
            lbl.Font = Enum.Font.GothamBold
        else
            row.BackgroundTransparency = 1
            local g = row:FindFirstChildOfClass("UIGradient")
            if g then g:Destroy() end
            ico.TextColor3 = COLOR_MUTED
            lbl.TextColor3 = COLOR_MUTED
            lbl.Font = Enum.Font.GothamMedium
        end
    end

    return {row = row, lbl = lbl, ico = ico, setActive = setActive}
end

