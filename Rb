    CollectionService = true, PathfindingService = true, Teams = true,
    ReplicatedFirst = true, ReplicatedStorage = true, ServerScriptService = true,
    ServerStorage = true, StarterGui = true, StarterPack = true, StarterPlayer = true,
    TestService = true, TextChatService = true, VoiceChatService = true,
    AssetService = true, BadgeService = true, GroupService = true,
    InsertService = true, JointsService = true, LocalizationService = true,
    NetworkClient = true, NetworkServer = true, ProximityPromptService = true,
    ScriptService = true, Selection = true, SocialService = true,
    TeleportService = true, TouchInputService = true, VRStatusService = true,
}

local function safeParent(obj)
    if not obj then return false end
    if RESTRICTED_SERVICES[obj.ClassName] then return false end
    if RESTRICTED_SERVICES[obj.Name] then return false end
    -- Service biasanya nggak punya Parent, atau Parent-nya game
    if obj.Parent == game or obj.Parent == nil then return false end
    local ok = pcall(function() obj.Parent = Workspace end)
    return ok
end

-- ============ PROCESS MODEL ============
local function processModelParts(inst)
    if not inst then return end
    local function isRestricted(o)
        if not o:IsA("BasePart") then return false end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and (o == p.Character or o:IsDescendantOf(p.Character)) then
                return true
            end
        end
        return false
    end
    if inst:IsA("BasePart") and not isRestricted(inst) then
        inst.Anchored = true
        inst.CanCollide = true
    end
    for _, desc in ipairs(inst:GetDescendants()) do
        if desc:IsA("BasePart") and not isRestricted(desc) then
            desc.Anchored = true
            desc.CanCollide = true
        end
    end
end

local function refreshScripts(model)
    task.defer(function()
        for _, desc in ipairs(model:GetDescendants()) do
            if desc:IsA("LocalScript") then
                local cur = desc.Enabled
                desc.Enabled = false
                task.wait(0.2)
                desc.Enabled = cur
            end
        end
    end)
end

-- ============ LOAD MODEL ============
local function loadModelFile(filePath)
    local toInsert = {}
    local okGet, res = pcall(function()
        if getobjects then
            local assetPath = getAsset(filePath)
            return getobjects(assetPath ~= "" and assetPath or filePath)
        end
    end)
    if okGet and res and type(res) == "table" and #res > 0 then
        for _, obj in ipairs(res) do table.insert(toInsert, obj) end
    else
        local okRead, rawData = pcall(function() return readFileData(filePath) end)
        if okRead and rawData then
            local okAsset, assetId = pcall(function() return getAsset(filePath) end)
            if okAsset and assetId and assetId ~= "" then
                local okIns, resIns = pcall(function()
                    return InsertService:LoadLocalAsset(assetId)
                end)
                if okIns and resIns then table.insert(toInsert, resIns) end
            end
        end
    end
    return toInsert
end

-- ============ HANDLE rbxl: EXTRACT WORKSPACE ONLY ============
local function importObject(obj)
    if not obj then return 0 end
    local count = 0

    -- Kalau DataModel / place: ambil isi Workspace-nya aja
    if obj.ClassName == "DataModel" then
        local ws = obj:FindFirstChild("Workspace")
        if ws then
            for _, child in ipairs(ws:GetChildren()) do
                if safeParent(child) then
                    processModelParts(child)
                    refreshScripts(child)
                    count = count + 1
                end
            end
        end
        return count
    end

    -- Kalau objek biasa
    if safeParent(obj) then
        processModelParts(obj)
        refreshScripts(obj)
        -- Spawn offset
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local spawnCFrame = hrp.CFrame + (hrp.CFrame.LookVector * 6)
            if obj:IsA("Model") and obj.PrimaryPart then
                pcall(function() obj:SetPrimaryPartCFrame(spawnCFrame) end)
            elseif obj:IsA("BasePart") then
                obj.CFrame = spawnCFrame
            end
        end
        count = 1
    end
    return count
end

