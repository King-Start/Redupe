local foundFiles = {}

local function makeFileCard(fileName, fileExt, filePath, parentFrame)
    local isRbxm = (fileExt == "rbxm" or fileExt == "rbxmx")
    local extColor = isRbxm and COLOR_RBXM or COLOR_RBXL

    local card = Instance.new("Frame")
    card.BackgroundColor3 = COLOR_BG
    card.Size = UDim2.new(1, -4, 0, 60)
    card.ZIndex = 6
    card.Parent = parentFrame
    corner(card, 8)

    local badge = Instance.new("TextButton")
    badge.Text = string.upper(fileExt)
    badge.Font = Enum.Font.GothamBold
    badge.TextSize = 7
    badge.TextColor3 = COLOR_TEXT
    badge.BackgroundColor3 = extColor
    badge.Size = UDim2.new(0, 40, 0, 15)
    badge.Position = UDim2.new(0, 8, 0, 7)
    badge.ZIndex = 7
    badge.AutoButtonColor = false
    badge.Parent = card
    corner(badge, 4)

    local importBtn = Instance.new("TextButton")
    importBtn.Text = "IMPORT"
    importBtn.Font = Enum.Font.GothamBold
    importBtn.TextSize = 7
    importBtn.TextColor3 = COLOR_TEXT
    importBtn.BackgroundColor3 = extColor
    importBtn.Size = UDim2.new(0, 54, 0, 18)
    importBtn.Position = UDim2.new(1, -62, 0, 7)
    importBtn.ZIndex = 7
    importBtn.Parent = card
    corner(importBtn, 4)

    makeLabel(card, fileName, UDim2.new(1,-80,0,12),
        UDim2.new(0,8,0,26), COLOR_TEXT, Enum.Font.GothamBold, 8).ZIndex = 7

    makeLabel(card, filePath, UDim2.new(1,-16,0,10),
        UDim2.new(0,8,0,44), COLOR_MUTED, Enum.Font.Code, 7).ZIndex = 7

    importBtn.MouseButton1Click:Connect(function()
        importBtn.Text = "..."
        statusText.Text = "LOADING " .. string.upper(fileName)
        setProgress(0.5)

        local loadedObjects = loadModelFile(filePath)
        local okCount = 0

        if loadedObjects and #loadedObjects > 0 then
            for _, obj in ipairs(loadedObjects) do
                local okP = pcall(function() obj.Parent = Workspace end)
                if okP then
                    processModelParts(obj)
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = LocalPlayer.Character.HumanoidRootPart
                        local cf = hrp.CFrame + (hrp.CFrame.LookVector * 6)
                        if obj:IsA("Model") and obj.PrimaryPart then
                            pcall(function() obj:SetPrimaryPartCFrame(cf) end)
                        elseif obj:IsA("BasePart") then
                            obj.CFrame = cf
                        end
                    end
                    processModelParts(obj)
                    refreshScripts(obj)
                    okCount = okCount + 1
                end
            end

            setProgress(1)
            statusText.Text = "IMPORTED " .. okCount .. " OBJECTS"
            importBtn.Text = "✓ DONE"
            importBtn.BackgroundColor3 = COLOR_SUCCESS
            statusLog.Text = "> OK: " .. fileName
        else
            setProgress(0)
            statusText.Text = "IMPORT FAILED"
            importBtn.Text = "✗ FAIL"
            importBtn.BackgroundColor3 = COLOR_DANGER
            statusLog.Text = "> FAIL: " .. fileName
        end

        task.delay(2, function()
            setProgress(0)
            statusText.Text = "IDLE"
        end)
    end)

    return card
end

-- ============ SCAN ============
local scanning = false

local function scanFiles()
    if scanning then return end
    scanning = true

    for _, c in ipairs(parserScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for _, c in ipairs(importerScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    foundFiles = {}

    scanBtn.Text = "SCANNING..."
    statusText.Text = "PARSING WORKSPACE ASSETS..."
    statusLog.Text = "> Scanning file..."
    setProgress(0.1)

    task.wait(0.2)

    local files = {}
    local pathsToTry = {
        "/sdcard/Download", "/sdcard/Documents", "/sdcard",
        "workspace", "", ".", "./"
    }
    for i, p in ipairs(pathsToTry) do
        setProgress(0.1 + (i / #pathsToTry) * 0.6)
        local ok, res = pcall(function() return getFiles(p) end)
        if ok and type(res) == "table" and #res > 0 then
            for _, f in ipairs(res) do table.insert(files, f) end
        end
        task.wait(0.05)
    end

    setProgress(0.8)

    local rbxmCount, rbxlCount = 0, 0
    for _, filePath in ipairs(files) do
        local fileName = filePath:match("[^/\\]+$") or filePath
        local ext = fileName:match("%.([^%.]+)$")
        if ext then
            local e = ext:lower()
            if e == "rbxm" or e == "rbxmx" then
                rbxmCount = rbxmCount + 1
                local card = makeFileCard(fileName, e, filePath, parserScroll)
                table.insert(foundFiles, {row = card, name = fileName, ext = e})
            elseif e == "rbxl" or e == "rbxlx" then
                rbxlCount = rbxlCount + 1
                local card = makeFileCard(fileName, e, filePath, importerScroll)
                table.insert(foundFiles, {row = card, name = fileName, ext = e})
            end
        end
    end

    countRbxm.Text = tostring(rbxmCount)
    countRbxl.Text = tostring(rbxlCount)

    setProgress(1)
    scanBtn.Text = "SCAN WORKSPACE"
    statusText.Text = "SCAN COMPLETE"
    statusLog.Text = string.format("> Found %d rbxm, %d rbxl", rbxmCount, rbxlCount)

    task.delay(2, function()
        setProgress(0)
        statusText.Text = "IDLE"
    end)

    scanning = false
end

scanBtn.MouseButton1Click:Connect(scanFiles)

