local sTab1 = makeSplashTab("CORE", 20)
local sTab2 = makeSplashTab("PARSER", 110)
local sTab3 = makeSplashTab("IMPORTER", 200)

local function setSplashProgress(p)
    p = math.clamp(p, 0, 1)
    splashBarFill.Size = UDim2.new(p, 0, 1, 0)
    splashPercent.Text = math.floor(p * 100) .. "%"

    -- Highlight tab berdasarkan progress
    local map = {
        {tab = sTab1, threshold = 0.33},
        {tab = sTab2, threshold = 0.66},
        {tab = sTab3, threshold = 1.0},
    }
    for i, m in ipairs(map) do
        local prevThreshold = (i == 1) and 0 or map[i-1].threshold
        local active = p >= prevThreshold and p <= m.threshold + 0.01
        local done = p > m.threshold
        if active or done then
            m.tab.dot.BackgroundColor3 = COLOR_ACCENT
            m.tab.lbl.TextColor3 = COLOR_TEXT
        else
            m.tab.dot.BackgroundColor3 = COLOR_DIM
            m.tab.lbl.TextColor3 = COLOR_DIM
        end
    end
end

