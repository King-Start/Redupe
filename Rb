-- ============ FIX: SAFE PARENT (hapus cek nil) ============
-- Service Roblox punya Parent == game. Objek baru dari getobjects punya Parent == nil.
-- Yang perlu di-skip cuma SERVICE, bukan semua yang Parent nil.

local function isService(obj)
    -- Service biasanya punya Parent == game dan ClassName-nya ada di daftar
    if RESTRICTED_SERVICES[obj.ClassName] then return true end
    if RESTRICTED_SERVICES[obj.Name] then return true end
    if obj.Parent == game then return true end
    return false
end

local function safeParent(obj)
    if not obj then return false end
    if isService(obj) then return false end
    local ok = pcall(function() obj.Parent = Workspace end)
    return ok
end

-- ============ FIX: IMPORT OBJECT (handle container & service) ============
local function importObject(obj)
    if not obj then return 0 end
    local count = 0

    -- Kalau DataModel (full place .rbxl): ambil Workspace-nya aja
    if obj.ClassName == "DataModel" then
        local ws = obj:FindFirstChild("Workspace")
        if ws then
            for _, child in ipairs(ws:GetChildren()) do
                if safeParent(child) then
                    processModelParts(child)
                    refreshScripts(child)
                    count = count + 1
                end
            end
        end
        return count
    end

    -- Kalau objek itu Workspace langsung: ambil isinya
    if obj.ClassName == "Workspace" then
        for _, child in ipairs(obj:GetChildren()) do
            if safeParent(child) then
                processModelParts(child)
                refreshScripts(child)
                count = count + 1
            end
        end
        return count
    end

    -- Kalau service yang nggak bisa di-parent: coba ambil descendant BasePart/Model
    if isService(obj) then
        for _, desc in ipairs(obj:GetDescendants()) do
            if desc:IsA("Model") or desc:IsA("BasePart") or desc:IsA("Folder") then
                if safeParent(desc) then
                    processModelParts(desc)
                    refreshScripts(desc)
                    count = count + 1
                end
            end
        end
        return count
    end

    -- Objek biasa: parent langsung
    if safeParent(obj) then
        processModelParts(obj)
        refreshScripts(obj)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local spawnCFrame = hrp.CFrame + (hrp.CFrame.LookVector * 6)
            if obj:IsA("Model") and obj.PrimaryPart then
                pcall(function() obj:SetPrimaryPartCFrame(spawnCFrame) end)
            elseif obj:IsA("BasePart") then
                obj.CFrame = spawnCFrame
            end
        end
        count = 1
    end

    return count
end
