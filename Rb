-- ============ FILE CARD BUILDER ============
local function buildFileCard(file)
    local card = make("Frame", {
        Size = UDim2.new(1, 0, 0, 78),
        BackgroundColor3 = Color3.fromRGB(20, 20, 30),
        BorderSizePixel = 0,
    }, {corner(10), stroke(Color3.fromRGB(60, 60, 90), 1)})

    -- Ext badge
    local extColor = file.ext == ".rbxm" and Color3.fromRGB(120, 90, 220)
        or file.ext == ".rbxl" and Color3.fromRGB(80, 140, 220)
        or Color3.fromRGB(200, 120, 60)
    local badge = make("TextButton", {
        Size = UDim2.new(0, 50, 0, 20),
        Position = UDim2.new(0, 10, 0, 8),
        BackgroundColor3 = extColor,
        Text = string.upper(string.gsub(file.ext, "%.", "")),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        BorderSizePixel = 0,
        AutoButtonColor = false,
    }, {corner(5)})
    badge.Parent = card

    -- Import button
    local importBtn = make("TextButton", {
        Size = UDim2.new(0, 70, 0, 22),
        Position = UDim2.new(1, -80, 0, 8),
        BackgroundColor3 = extColor,
        Text = "IMPORT",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        BorderSizePixel = 0,
    }, {corner(5)})
    importBtn.Parent = card

    -- File name
    local nameLbl = make("TextLabel", {
        Size = UDim2.new(1, -100, 0, 18),
        Position = UDim2.new(0, 10, 0, 30),
        BackgroundTransparency = 1,
        Text = file.name,
        TextColor3 = CONFIG.TextColor,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    nameLbl.Parent = card

    -- Path
    make("TextLabel", {
        Size = UDim2.new(1, -20, 0, 14),
        Position = UDim2.new(0, 10, 0, 50),
        BackgroundTransparency = 1,
        Text = file.path,
        TextColor3 = Color3.fromRGB(110, 110, 140),
        Font = Enum.Font.Code,
        TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }).Parent = card

    -- Import action
    importBtn.MouseButton1Click:Connect(function()
        importBtn.Text = "..."
        importBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        log("Importing: " .. file.name)

        local ok, err = pcall(function()
            local data = readFile(file.path)
            if not data then error("readfile gagal — cek path") end

            -- Method 1: GetObjects
            local got = game:GetObjects(file.path)
            if got and #got > 0 then
                for _, obj in ipairs(got) do
                    obj.Parent = game:GetService("Workspace")
                end
                return #got
            end

            -- Method 2: InsertService fallback
            local IS = game:GetService("InsertService")
            local model = IS:LoadLocalAsset(file.path)
            model.Parent = game:GetService("Workspace")
            return 1
        end)

        if ok then
            State.imported = State.imported + 1
            importBtn.Text = "✓ DONE"
            importBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
            countsLabel.Text = string.format("FILES %d  •  IMP %d", #State.files, State.imported)
            log("Imported: " .. file.name)
        else
            importBtn.Text = "✗ FAIL"
            importBtn.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
            log("Gagal: " .. tostring(err))
        end
    end)

    return card
end

-- ============ SCAN LOGIC ============
local function renderFiles(filter)
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local shown = 0
    for _, file in ipairs(State.files) do
        if filter == "" or string.find(string.lower(file.name), string.lower(filter), 1, true) then
            buildFileCard(file).Parent = scroll
            shown = shown + 1
        end
    end

    scroll.CanvasSize = UDim2.new(0, 0, 0, shown * 84)
    return shown
end

scanBtn.MouseButton1Click:Connect(function()
    scanBtn.Text = "SCANNING..."
    statusLabel.Text = "SCANNING..."
    statusDot.BackgroundColor3 = Color3.fromRGB(240, 200, 80)
    State.files = {}
    State.rbxmCount = 0
    State.rbxlCount = 0

    task.wait(0.1)

    local scannedAny = false
    for _, dir in ipairs(CONFIG.ScanPaths) do
        local ok, files = pcall(function() return listFiles(dir) end)
        if ok and files then
            scannedAny = true
            for _, path in ipairs(files) do
                local name = string.match(path, "([^/]+)$") or path
                local isModel, ext = isModelFile(name)
                if isModel then
                    table.insert(State.files, {name = name, path = path, ext = ext})
                    if ext == ".rbxm" then State.rbxmCount = State.rbxmCount + 1
                    elseif ext == ".rbxl" then State.rbxlCount = State.rbxlCount + 1 end
                end
            end
        end
    end

    task.wait(0.1)
    renderFiles("")

    scanBtn.Text = "SCAN"
    statusDot.BackgroundColor3 = Color3.fromRGB(80, 200, 120)

    if not scannedAny then
        statusLabel.Text = "SCAN FAILED — listfiles nil"
        log("listfiles() nggak tersedia. Executor kamu nggak support scan otomatis.")
    else
        statusLabel.Text = string.format("SCAN COMPLETE  •  RBXL %d  •  RBXM %d", State.rbxlCount, State.rbxmCount)
        countsLabel.Text = string.format("FILES %d  •  IMP %d", #State.files, State.imported)
        log(string.format("Scan selesai: %d file ditemukan.", #State.files))
    end
end)

