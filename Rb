-- ============ VORTEX BORDER (versi ungu ENI) ============
local function applyVortexBorder(target)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(160, 100, 255)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(90, 60, 200)),
        ColorSequenceKeypoint.new(0.66, Color3.fromRGB(200, 150, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(140, 80, 230)),
    })
    gradient.Parent = target
    RunService.RenderStepped:Connect(function()
        gradient.Rotation = (tick() * 50) % 360
    end)
end

-- ============ PROCESS MODEL ============
local function processModelParts(inst)
    if not inst then return end
    local function isRestricted(obj)
        if not obj:IsA("BasePart") then return false end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and (obj == p.Character or obj:IsDescendantOf(p.Character)) then
                return true
            end
        end
        if Workspace.CurrentCamera and (obj == Workspace.CurrentCamera or obj:IsDescendantOf(Workspace.CurrentCamera)) then
            return true
        end
        return false
    end
    if inst:IsA("BasePart") and not isRestricted(inst) then
        inst.Anchored = true
        inst.CanCollide = true
    end
    for _, desc in ipairs(inst:GetDescendants()) do
        if desc:IsA("BasePart") and not isRestricted(desc) then
            desc.Anchored = true
            desc.CanCollide = true
        end
    end
end

local function refreshScripts(model)
    task.defer(function()
        for _, desc in ipairs(model:GetDescendants()) do
            if desc:IsA("LocalScript") then
                local cur = desc.Enabled
                desc.Enabled = false
                task.wait(0.2)
                desc.Enabled = cur
            end
        end
    end)
end

-- ============ LOAD MODEL (pola ALLZ) ============
local function loadModelFile(filePath)
    local toInsert = {}

    -- Coba via getobjects + getcustomasset
    local okGet, res = pcall(function()
        if getobjects then
            local assetPath = getAsset(filePath)
            return getobjects(assetPath ~= "" and assetPath or filePath)
        end
    end)

    if okGet and res and type(res) == "table" and #res > 0 then
        for _, obj in ipairs(res) do
            table.insert(toInsert, obj)
        end
    else
        -- Fallback: baca file, coba getAsset + InsertService
        local okRead, rawData = pcall(function() return readFileData(filePath) end)
        if okRead and rawData then
            local okAsset, assetId = pcall(function() return getAsset(filePath) end)
            if okAsset and assetId and assetId ~= "" then
                local okIns, resIns = pcall(function()
                    return InsertService:LoadLocalAsset(assetId)
                end)
                if okIns and resIns then
                    table.insert(toInsert, resIns)
                end
            end
        end
    end

    return toInsert
end

