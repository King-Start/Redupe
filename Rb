-- ============ SAFE FUNCTION RESOLVER ============
local function getFn(name)
    -- cek global dulu
    if _G[name] and type(_G[name]) == "function" then return _G[name] end
    -- cek executor table
    local execs = {syn, fluxus, delta, codex, arceusx}
    for _, e in ipairs(execs) do
        if type(e) == "table" and type(e[name]) == "function" then
            return e[name]
        end
    end
    return nil
end

local _readfile  = getFn("readfile")
local _listfiles = getFn("listfiles")
local _writefile = getFn("writefile")

-- ============ SAFE WAIT ============
local function wait_(t)
    if task and task.wait then task.wait(t) end
    if wait then wait(t) end
end

