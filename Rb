-- ============ FILE CARD ============
local foundFiles = {}

local function makeFileCard(fileName, fileExt, filePath)
    local isRbxm = (fileExt == "rbxm" or fileExt == "rbxmx")
    local extColor = isRbxm and COLOR_RBXM or COLOR_RBXL

    local card = Instance.new("Frame")
    card.BackgroundColor3 = COLOR_SURFACE_2
    card.Size = UDim2.new(1, -4, 0, 56)
    card.ZIndex = 3
    card.Parent = fileScroll
    corner(card, 7)

    local badge = Instance.new("TextButton")
    badge.Text = string.upper(fileExt)
    badge.Font = Enum.Font.GothamBold
    badge.TextSize = 7
    badge.TextColor3 = COLOR_TEXT
    badge.BackgroundColor3 = extColor
    badge.Size = UDim2.new(0, 40, 0, 15)
    badge.Position = UDim2.new(0, 8, 0, 7)
    badge.ZIndex = 4
    badge.AutoButtonColor = false
    badge.Parent = card
    corner(badge, 4)

    local importBtn = Instance.new("TextButton")
    importBtn.Text = "IMPORT"
    importBtn.Font = Enum.Font.GothamBold
    importBtn.TextSize = 7
    importBtn.TextColor3 = COLOR_TEXT
    importBtn.BackgroundColor3 = extColor
    importBtn.Size = UDim2.new(0, 54, 0, 18)
    importBtn.Position = UDim2.new(1, -62, 0, 7)
    importBtn.ZIndex = 4
    importBtn.Parent = card
    corner(importBtn, 4)

    makeLabel(card, fileName, UDim2.new(1,-80,0,12),
        UDim2.new(0,8,0,26), COLOR_TEXT, Enum.Font.GothamBold, 8).ZIndex = 4

    makeLabel(card, filePath, UDim2.new(1,-16,0,10),
        UDim2.new(0,8,0,40), COLOR_MUTED, Enum.Font.Code, 7).ZIndex = 4

    -- ============ IMPORT (ALLZ logic) ============
    importBtn.MouseButton1Click:Connect(function()
        importBtn.Text = "..."
        log("Loading: " .. fileName)

        local loadedObjects = loadModelFile(filePath)

        if loadedObjects and #loadedObjects > 0 then
            for _, obj in ipairs(loadedObjects) do
                local okParent, err = pcall(function() obj.Parent = Workspace end)
                if okParent then
                    processModelParts(obj)
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = LocalPlayer.Character.HumanoidRootPart
                        local spawnCFrame = hrp.CFrame + (hrp.CFrame.LookVector * 6)
                        if obj:IsA("Model") and obj.PrimaryPart then
                            pcall(function() obj:SetPrimaryPartCFrame(spawnCFrame) end)
                        elseif obj:IsA("BasePart") then
                            obj.CFrame = spawnCFrame
                        end
                    end
                    processModelParts(obj)
                    refreshScripts(obj)
                    log("Berhasil: " .. tostring(obj.Name))
                else
                    log("Skip: " .. tostring(obj.Name))
                end
            end
            importBtn.Text = "✓ DONE"
            importBtn.BackgroundColor3 = COLOR_SUCCESS
        else
            importBtn.Text = "✗ FAIL"
            importBtn.BackgroundColor3 = COLOR_DANGER
            log("Gagal load: " .. fileName)
        end
    end)

    return card
end

-- ============ SCAN ============
local scanning = false

local function scanFiles()
    if scanning then return end
    scanning = true

    for _, child in ipairs(fileScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    foundFiles = {}

    scanBtn.Text = "SCANNING..."
    scanBtn.BackgroundColor3 = COLOR_SURFACE_2
    statusDot.BackgroundColor3 = Color3.fromRGB(240, 200, 80)
    statusLabel.Text = "SCANNING..."
    log("Scanning file...")

    task.wait(0.1)

    local files = {}
    local pathsToTry = {
        "/sdcard/Download",
        "/sdcard/Documents",
        "/sdcard",
        "workspace", "", ".", "./"
    }
    for _, p in ipairs(pathsToTry) do
        local ok, res = pcall(function() return getFiles(p) end)
        if ok and type(res) == "table" and #res > 0 then
            for _, f in ipairs(res) do table.insert(files, f) end
        end
    end

    local rbxmCount, rbxlCount = 0, 0
    for _, filePath in ipairs(files) do
        local fileName = filePath:match("[^/\\]+$") or filePath
        local ext = fileName:match("%.([^%.]+)$")
        if ext then
            local e = ext:lower()
            if e == "rbxm" or e == "rbxmx" or e == "rbxl" or e == "rbxlx" then
                local card = makeFileCard(fileName, e, filePath)
                table.insert(foundFiles, {row = card, name = fileName, ext = e})
                if e == "rbxm" or e == "rbxmx" then rbxmCount = rbxmCount + 1
                else rbxlCount = rbxlCount + 1 end
            end
        end
    end

    scanBtn.Text = "SCAN"
    scanBtn.BackgroundColor3 = COLOR_ACCENT
    statusDot.BackgroundColor3 = COLOR_SUCCESS
    statusLabel.Text = string.format("SCAN COMPLETE  •  RBXL %d  •  RBXM %d", rbxlCount, rbxmCount)
    countsLabel.Text = string.format("FILES %d  •  IMP 0", #foundFiles)
    log(string.format("Scan selesai. %d file.", #foundFiles))

    scanning = false
end

scanBtn.MouseButton1Click:Connect(scanFiles)
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local q = searchBox.Text:lower()
    for _, item in ipairs(foundFiles) do
        item.row.Visible = (q == "" or item.name:lower():find(q, 1, true) ~= nil)
    end
end)

log("sadvze x cute importer ready.")
task.spawn(function()
    task.wait(0.5)
    scanFiles()
end)
