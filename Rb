        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 210, 120)),  -- gold
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(170, 120, 255)),  -- purple
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(80, 180, 255)),   -- blue
